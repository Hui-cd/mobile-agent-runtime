# MCP mode needs no model API key. These values are only for the optional BYOK gateway.
MOBILE_AGENT_PROVIDER=openai-responses
MOBILE_AGENT_API_KEY=
MOBILE_AGENT_MODEL=
MOBILE_AGENT_BASE_URL=https://api.openai.com/v1

# Required if MOBILE_AGENT_GATEWAY_HOST is not loopback.
MOBILE_AGENT_GATEWAY_HOST=127.0.0.1
MOBILE_AGENT_GATEWAY_PORT=8787
MOBILE_AGENT_GATEWAY_TOKEN=

# Optional device selection and Unicode companion IME integration.
ANDROID_SERIAL=
MOBILE_AGENT_ADB=
MOBILE_AGENT_UNICODE_IME_ACTION=
